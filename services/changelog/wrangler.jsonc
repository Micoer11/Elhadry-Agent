{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opencode-changelog",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-15",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
  },
  // Exact path plus subpaths, so the Console keeps /changelog.json and the localized /<locale>/changelog pages.
  "routes": [
    {
      "pattern": "elhadry.ai/changelog",
      "zone_name": "elhadry.ai",
    },
    {
      "pattern": "elhadry.ai/changelog/*",
      "zone_name": "elhadry.ai",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
